{
  "name": "clipzy-desktop",
  "version": "1.0.0",
  "description": "Clipzy desktop app",
  "main": "main.js",
  "author": "Clipzy",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.clipzy.app",
    "productName": "Clipzy",
    "files": ["main.js", "config.json", "icon.png", "offline.html"],
    "directories": { "output": "dist" },
    "win": { "target": "nsis", "icon": "icon.png", "artifactName": "Clipzy-Setup.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true },
    "mac": { "target": "dmg", "icon": "icon.png", "category": "public.app-category.social-networking", "artifactName": "Clipzy.${ext}" },
    "linux": { "target": "AppImage", "icon": "icon.png", "category": "Network", "artifactName": "Clipzy.${ext}" }
  }
}
