{
  "name": "clipzy",
  "version": "1.0.0",
  "private": true,
  "description": "A short-video social platform (TikTok-inspired) with feeds, uploads, LIVE, DMs, notifications and admin tools.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "seed": "node server/seed.js",
    "make-admin": "node server/scripts/make-admin.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "start:prod": "node server/scripts/bootstrap.js && node server/index.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "ws": "^8.18.3"
  }
}
