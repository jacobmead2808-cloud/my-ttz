# Copy to .env and adjust. All values are optional for local development.
PORT=4000
APP_NAME=Clipzy
# Public URL used in password-reset emails and share links
BASE_URL=http://localhost:4000
NODE_ENV=development

# Storage locations (relative to project root)
DATA_DIR=data
UPLOAD_DIR=uploads
MAX_VIDEO_MB=200
SESSION_DAYS=30
# Set to 1 when running behind a reverse proxy (nginx, Render, Fly...) so req.ip / secure cookies work
TRUST_PROXY=0

# Owner account, created on the first start of an empty database (bootstrap).
# Production refuses to start without a real email and a strong password (10+ chars).
ADMIN_EMAIL=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Public contact address shown on the Terms / Privacy / Safety pages
CONTACT_EMAIL=

# Email confirmation for new accounts: always on in production (needs an email provider),
# off in development unless set to true.
# REQUIRE_EMAIL_VERIFICATION=true

# ---- DEVELOPMENT ONLY (ignored when NODE_ENV=production) ----
# SEED_DEMO=true        demo accounts + sample videos on first start (`npm run seed` does the same)
# SEED_PASSWORD=        password for the demo accounts

# Email (password reset). Leave MAIL_PROVIDER empty for dev mode:
# reset links are printed to the server console and saved in data/outbox/.
# Supported provider: resend (https://resend.com) - needs an API key and a verified sender domain.
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=Clipzy <no-reply@yourdomain.com>

# WebRTC ICE servers for LIVE (JSON array). STUN works on most home networks;
# add a TURN server (e.g. coturn, Twilio, Metered, Cloudflare) for users behind strict NATs.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Auto-captions (optional). Without these, captions can still be written by hand in the editor.
# STT_PROVIDER=openai
# OPENAI_API_KEY=
# STT_MODEL=whisper-1

# ---- Coins (Stripe Checkout). Without these, coin purchases are off in production (dev builds use free demo coins). ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (webhook URL: https://your-domain/api/coins/webhook, event: checkout.session.completed)
# COINS_DEMO_MODE=true              (force demo coins on/off)

# ---- Guardian AI moderation (optional; rules-based without it) ----
# AI_MODERATION=openai
# OPENAI_API_KEY=
# AI_MODERATION_MODEL=omni-moderation-latest

# Owner-only secret required to give verification badges. Pick your own long random value.
# (Development falls back to a built-in key; production has none unless you set this.)
VERIFY_KEY=

# Daily database snapshots (on by default in production): data/backups, kept 7 days
# BACKUPS=true
# BACKUP_DIR=
# BACKUP_KEEP_DAYS=7
