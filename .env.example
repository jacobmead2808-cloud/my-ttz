# Copy to .env and adjust. All values are optional for local development.
PORT=4000
APP_NAME=Clipzy
# Public URL used in password-reset emails and share links
BASE_URL=http://localhost:4000
NODE_ENV=development

# Storage locations (relative to project root)
DATA_DIR=data
UPLOAD_DIR=uploads
MAX_VIDEO_MB=200
SESSION_DAYS=30
# Set to 1 when running behind a reverse proxy (nginx, Render, Fly...) so req.ip / secure cookies work
TRUST_PROXY=0

# Seed / bootstrap admin (used by `npm run seed`)
ADMIN_EMAIL=admin@clipzy.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe-Admin1!
# Password given to the seeded demo accounts
SEED_PASSWORD=Demo-Pass123!

# Email (password reset). Leave MAIL_PROVIDER empty for dev mode:
# reset links are printed to the server console and saved in data/outbox/.
# Supported provider: resend (https://resend.com) - needs an API key and a verified sender domain.
MAIL_PROVIDER=
RESEND_API_KEY=
MAIL_FROM=Clipzy <no-reply@yourdomain.com>

# WebRTC ICE servers for LIVE (JSON array). STUN works on most home networks;
# add a TURN server (e.g. coturn, Twilio, Metered, Cloudflare) for users behind strict NATs.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Auto-captions (optional). Without these, captions can still be written by hand in the editor.
# STT_PROVIDER=openai
# OPENAI_API_KEY=
# STT_MODEL=whisper-1

# ---- Coins (Stripe Checkout). Without these, dev builds use free demo coins. ----
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (webhook URL: https://your-domain/api/coins/webhook, event: checkout.session.completed)
# COINS_DEMO_MODE=true              (force demo coins on/off)

# ---- Guardian AI moderation (optional; rules-based without it) ----
# AI_MODERATION=openai
# OPENAI_API_KEY=
# AI_MODERATION_MODEL=omni-moderation-latest

# Owner-only key required to verify accounts in the moderation centre
VERIFY_KEY=weluvjj
